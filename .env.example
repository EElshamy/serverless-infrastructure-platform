# ---------- Local development (default) ----------
NODE_ENV=development

# PostgreSQL (Docker Compose)
POSTGRES_USER=devops
POSTGRES_PASSWORD=devops
POSTGRES_DB=devops_academy
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devops:devops@localhost:5432/devops_academy

# Services
API_PORT=4000
WEB_PORT=3000

# URL configuration - change these together for production.
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session / cookie security
SESSION_SECRET=replace-with-a-long-random-string
COOKIE_NAME=devops_academy_session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=7

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Seed account (dev-only credentials; use strong values in any shared environment)
SEED_ADMIN_NAME=Academy Admin
SEED_ADMIN_EMAIL=admin@devopsacademy.local
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_USER_PASSWORD=change-this-student-password

# ---------- Production reference (do not enable during local development) ----------
# NODE_ENV=production
# WEB_URL=https://elshamy.online
# API_URL=https://api.elshamy.online
# NEXT_PUBLIC_API_URL=https://api.elshamy.online
# CORS_ORIGINS=https://elshamy.online
# COOKIE_DOMAIN=.elshamy.online
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
